datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  username             String     @unique
  passwordHash         String
  avatarUrl            String?
  status               UserStatus @default(OFFLINE)
  role                 Role       @default(USER)
  storageUsed          Float      @default(0.0)
  birthDate            DateTime?
  country              String?
  city                 String?
  lastKnownIp          String?
  isEmailVerified      Boolean    @default(false)
  twoFactorCode        String?
  twoFactorExpires     DateTime?
  twoFactorAttempts    Int        @default(0)
  twoFactorLockedUntil DateTime?
  resetCode            String?
  resetExpires         DateTime?
  resetAttempts        Int        @default(0)
  resetLockedUntil     DateTime?
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  themePreference      String     @default("dark")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  sessions     Session[]
  folders      Folder[]
  files        File[]
  contacts     Contact[]
  clipboards   Clipboard[]
  activityLogs ActivityLog[]

  @@index([email])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  deviceAgent String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Folder {
  id            String    @id @default(cuid())
  name          String
  thumbnailPath String?
  userId        String
  parentId      String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("SubFolders")
  files    File[]

  @@index([userId])
  @@index([parentId])
}

model File {
  id            String    @id @default(cuid())
  filename      String
  storedName    String
  mimeType      String
  size          Float
  path          String
  thumbnailPath String?
  userId        String
  folderId      String?
  isPublic      Boolean   @default(false)
  isStarred     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  shareLinks ShareLink[]

  @@index([userId])
  @@index([folderId])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Clipboard {
  id        String        @id @default(cuid())
  content   String
  type      ClipboardType @default(TEXT)
  userId    String
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShareLink {
  id         String   @id @default(cuid())
  fileId     String
  token      String   @unique
  expiresAt  DateTime
  viewsCount Int      @default(0)
  createdAt  DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([token])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  USER
  GUEST
}

enum UserStatus {
  ONLINE
  OFFLINE
  BUSY
  AWAY
  INVISIBLE
}

enum ClipboardType {
  TEXT
  URL
  CODE
}